{
  "name": "stardew-companion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-locales.mjs",
    "prebuild": "node scripts/build-locales.mjs",
    "pretest": "node scripts/build-locales.mjs",
    "pretypecheck": "node scripts/build-locales.mjs",
    "locale:collect": "node scripts/collect-messages.mjs",
    "locale:check": "node scripts/check-locales.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bridge:build": "node scripts/build-bridge.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "knowledge:validate": "vitest run src/domain/knowledge.test.ts",
    "knowledge:import": "node scripts/import-knowledge.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts e2e *.ts *.json *.md data .github"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
}
